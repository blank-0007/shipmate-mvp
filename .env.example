# Supabase Configuration
# Optional: If not provided, ShipMate gracefully falls back to persistent local storage for demo/development.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Personal GitHub token to increase public rate limits (60 req/hr -> 5000 req/hr)
VITE_GITHUB_TOKEN=
